# OpenAI API used by the fixed research agent.
OPENAI_API_KEY=

# Configure only the search providers selected with --vendors.
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
LINKUP_API_KEY=
PARALLEL_API_KEY=
SELTZ_API_KEY=
RAPIDAPI_KEY=
TAVILY_API_KEY=
YOU_API_KEY=
TINYFISH_API_KEY=
PERPLEXITY_API_KEY=

# Optional limits for the bounded HTTP/Playwright fallback.
COMPANY_RESEARCH_FETCH_MAX_BROWSERS=4
COMPANY_RESEARCH_FETCH_NAV_TIMEOUT_MS=12000
COMPANY_RESEARCH_FETCH_SETTLE_MS=2000

# Nimble Search / Agents
NIMBLE_API_KEY=
# Optional contracted Extract price; unset means unknown, not free.
# NIMBLE_EXTRACT_USD_PER_REQUEST=

# Jevlin (benchmark fork; scripts/company_research/jevlin_vendor.py over the vendored scripts/jevlin_core/).
# The HTTP arms (jevlin_fast, jevlin_balanced, jevlin_single, jevlin_fanout_*) need the key; the
# fan-out arms refuse to run without a pinned provider set.
JEVLIN_API_KEY=
JEVLIN_API_URL=https://api.jevlin.ai
# Pinned provider set for jevlin_fanout_raw / jevlin_fanout_merged (comma list; required for those arms).
JEVLIN_PROVIDERS=
# Provider for jevlin_single (default exa).
JEVLIN_SINGLE_PROVIDER=exa
# The released jevlin executable for jevlin_cli, and its benchmark-only config (experiments/jevlin-cli/setup.sh).
# JEVLIN_CLI_CONFIG, not JEVLIN_CONFIG: a JEVLIN_CONFIG exported by your shell would win over this file.
JEVLIN_BIN=
JEVLIN_CLI_CONFIG=
JEVLIN_TIMEOUT_S=45

# The Claude Code runner (scripts/jevlin_bench/cc_run_company.py) bills the subscription and starts
# every session with an empty environment: it must never see an API key. Do not set ANTHROPIC_API_KEY here.
